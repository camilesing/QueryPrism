# Database — PostgreSQL 18 + pgvector (see backend/docs/postgres.md)
# Local devcontainer: host "db". Host-based development: host "localhost".
DATABASE_URL="postgresql://queryprism:queryprism@localhost:5432/queryprism"

# Application
PORT=3000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:5173

# AES encryption secret (datasource configuration / ai_model api_key).
# CHANGE IN PRODUCTION. Rotation requires re-encrypting existing secrets.
AES_KEY=queryprism-aes-key-change-me-32b

# JWT auth (local login only — no SSO)
JWT_SECRET=queryprism-jwt-secret-change-me
JWT_EXPIRES_IN=11520m
TOKEN_KEY=X-QUERYPRISM-TOKEN

# LLM provider (multi-provider via LangChain.js, Phase 4)
LLM_DEFAULT_SUPPLIER=openai
LLM_DEFAULT_MODEL=
LLM_API_KEY=
LLM_API_DOMAIN=

# Embeddings (Phase 3). provider: openai | local
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_API_DOMAIN=
EMBEDDING_MODEL=text-embedding-3-small
# Optional check; must match the model. OpenAI text-embedding-3-small = 1536,
# Xenova/all-MiniLM-L6-v2 = 384. Leave unset to infer from the first vector.
EMBEDDING_DIMENSION=1536
EMBEDDING_LOCAL_MODEL=Xenova/all-MiniLM-L6-v2
# Legacy retrieval tuning — feeds data-training similarity/top-count when the
# upstream-named keys below are absent.
EMBEDDING_THRESHOLD=0.4
EMBEDDING_TOP_K=5

# Embedding retrieval strategy. Startup DEFAULTS only —
# the admin parameter page persists overrides (embedding.* SystemVariable)
# with priority saved > env > code default; each chat task reads one snapshot.
EMBEDDING_ENABLED=true
EMBEDDING_DATA_TRAINING_SIMILARITY=0.4
EMBEDDING_DATA_TRAINING_TOP_COUNT=5
TABLE_EMBEDDING_ENABLED=true
TABLE_EMBEDDING_COUNT=10
TABLE_EMBEDDING_ALPHA=0.4
TABLE_EMBEDDING_KEYWORD_ENABLED=true
DS_EMBEDDING_COUNT=10

# Metric vector recall (MetaDataImprove M4 follow-up). Metric matching is
# literal-first; a metric vector whose cosine similarity to the question
# EXCEEDS this threshold may fill the remaining metric.max_definitions slots
# (atomic metrics only). Stricter than the terminology default on purpose:
# short, domain-adjacent metric names produce confident false positives.
# Skipped (literal-only) when no embedding key / pgvector is available.
METRIC_SIMILARITY_THRESHOLD=0.55

# Chat pipeline (Phase 5)
QUERYPRISM_NAME=QueryPrism
CHAT_LIMIT_ROWS=1000
CHAT_HISTORY_ROUND_COUNT=3
CHAT_LIMIT=20

# Query cost (MetaDataImprove M7). Startup layer of the runtime parameters —
# the admin parameter page (quota.max_rows / cache.enabled /
# cache.ttl_seconds) overrides these. QUOTA_MAX_ROWS falls back to the legacy
# CHAT_LIMIT_ROWS above.
QUOTA_MAX_ROWS=1000
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300

# g2-ssr chart->PNG microservice (Phase 7)
G2_SSR_HOST=http://localhost:3001
MCP_IMAGE_PATH=./images

# Local file datasources (Excel/CSV). Uploaded source files live under
# EXCEL_UPLOAD_DIR; imported sheets live in the app PostgreSQL schema
# EXCEL_STORE_SCHEMA (created lazily, outside Prisma's managed schema).
EXCEL_UPLOAD_DIR=uploads/excel
EXCEL_STORE_SCHEMA=excel_store

# Excel import failure workbooks (data-training/custom-prompt/user)
# served by POST /system/download-fail-info and GET /user/errorRecord/:key.
IMPORT_ERROR_DIR=uploads/import-errors

# Appearance branding images (logo/login background/nav background).
APPEARANCE_UPLOAD_DIR=uploads/appearance
