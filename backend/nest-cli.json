{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "llm/**/*.yaml", "outDir": "dist/src" },
      { "include": "i18n/**/*", "outDir": "dist/src", "watch": false }
    ],
    "watchAssets": true
  }
}
