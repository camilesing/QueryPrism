{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@mistralai/mistralai/lib/http\\.js$": "<rootDir>/mocks/mistralai-http.cjs",
    "^@mistralai/mistralai$": "<rootDir>/mocks/mistralai-sdk.cjs"
  },
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "maxWorkers": 1
}
